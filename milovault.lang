[en-us]
name = "MiloVault"
auth = "miaoqi"
descript = "Self-hosted Vaultwarden password vault served at https://<NAS-IP>:18443 with a self-signed HTTPS certificate, provides the web vault and a Bitwarden-compatible API."
release_note = "1.0.1: fixed the clean-install restart loop caused by /data permissions, added an init service to prepare ownership, made certificate generation verifiable and idempotent, tightened file permissions, added a privacy policy, and aligned the description with the delivered web vault."
important = "The first launch uses a self-signed HTTPS certificate and the browser will warn. Disable signups after creating the first account. For production, place it behind a trusted HTTPS reverse proxy."

[fr-fr]
